[Unit]
Description=Daily upgrade of the Claude models OpenClaw runs on (smoke-tested, health-checked, self-rolling-back)
Documentation=file://@LIBEXEC@/scripts/openclaw/openclaw-models-update.sh

[Service]
Type=oneshot
# 15 min covers the gateway stop (TimeoutStopSec=330), the health poll and the smoke calls.
TimeoutStartSec=900
ExecStart=/bin/bash @LIBEXEC@/scripts/openclaw/openclaw-models-update.sh
