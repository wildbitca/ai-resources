# ~/.openclaw/kit-host.env — the host-specific values the OpenClaw host scripts read.
#
# `ai-resources setup` writes this file from the questions it asks. To do it by hand, copy this
# file to ~/.openclaw/kit-host.env and edit it. Secrets never belong here: use `openclaw configure`.
# It is sourced by bash and read by the team hook, so keep it to plain KEY=value lines.

# Telegram id of the operator, for failure notices. Empty: the scripts log and stay quiet.
OPENCLAW_OWNER_TELEGRAM_ID=

# Seconds the gateway may sit in `deactivating` before the watchdog sends a Telegram alert (T39).
# Keep it below the unit's TimeoutStopSec (330 s), or a stop that ends in SIGKILL never alerts.
#OPENCLAW_WATCHDOG_DEACTIVATING_ALERT_SEC=240

# Where the watchdog reads the monotonic clock (default /proc/uptime); only tests change it.
#OPENCLAW_UPTIME_FILE=/proc/uptime

# Where the backup tiers (daily/weekly/monthly) are written. Stage on disk, never on /tmp.
OPENCLAW_BACKUP_DIR=/srv/openclaw-backups

# Workspaces (paths relative to $HOME, space separated) added to the backup on top of the
# ones read from openclaw.json.
OPENCLAW_BACKUP_EXTRA=

# Off-box upload target for openclaw-backup-uploader.sh, e.g. gs://my-bucket. Empty: the
# uploader refuses to run rather than silently doing nothing. The kit never picks a
# destination or a credential path for you (another host, S3, a GCS bucket are all yours
# to choose), and the command used to check for an off-box copy from `openclaw status` is
# OPENCLAW_OFFBOX_LIST_CMD below, set independently.
OPENCLAW_OFFBOX_BUCKET=

# Command that lists the off-box daily tier, used by `openclaw status`/`ai-resources verify`
# to confirm the newest local daily actually left the host (e.g. `gcloud storage ls
# gs://my-bucket/daily`). Empty: reported as "not configured", never assumed missing.
OPENCLAW_OFFBOX_LIST_CMD=

# How much the team hook narrates into Telegram: milestones | every-step. ABSENT MEANS OFF: the
# hook publishes nothing without this key, even in a session started by the gateway. Present only
# when the team narration hook is enabled; `openclaw-verify.sh` then expects the hook to be registered.
#OPENCLAW_NARRATION=milestones

# Language of what the team hook and its live messages write into Telegram: en | es. Absent or
# any other value means en. Only read while the narration above is on.
#OPENCLAW_NARRATION_LANG=en

# 1 when the gateway guard hook is enabled (verify then expects it to be registered).
#OPENCLAW_GUARD=1

# Written by `ai-resources openclaw bootstrap` when it installs openclaw (the kit installs the
# latest, not a pin). This file is then the only record of which version was running: back it up,
# and restore it before anything else on a rebuild. PREVIOUS is the one-command rollback target.
#OPENCLAW_INSTALLED_VERSION=
#OPENCLAW_PREVIOUS_VERSION=

# Graceful restart under confirmed memory pressure (ADR-0004), read by openclaw-health-restart.sh and by
# `ai-resources openclaw graceful-restart`. `notify` (default) only tells you what it would do; `on`
# restarts, inside the window or above the hard ceiling; `off` only logs. Enable `on` after ONE supervised
# `ai-resources openclaw graceful-restart --reason manual` showed no duplicated or lost messages.
#OPENCLAW_GRACEFUL_RESTART=notify
# HH:MM-HH:MM in OPENCLAW_RESTART_TZ (the host clock is UTC). It may wrap midnight. Empty: no window, only the
# hard ceiling acts.
#OPENCLAW_RESTART_WINDOW=02:00-05:00
#OPENCLAW_RESTART_TZ=America/Guayaquil
# % of MemoryHigh above which the window is overridden / at which pressure starts to count (swap >= 90 % too).
#OPENCLAW_RESTART_HARD_PCT=105
#OPENCLAW_RESTART_PRESSURE_PCT=90
# Seconds between restarts, and restarts per local day (0 = no cap).
#OPENCLAW_RESTART_COOLDOWN_S=10800
#OPENCLAW_RESTART_DAILY_CAP=2
# Seconds between the two confirming samples; "still starting" for this long counts as frozen; wait after the
# restart before the post-snapshot; snapshot directories kept under ~/.openclaw/logs/restart-snapshots/.
#OPENCLAW_HEALTH_CONFIRM_S=60
#OPENCLAW_FROZEN_MIN_S=600
#OPENCLAW_RESTART_SETTLE_S=120
#OPENCLAW_RESTART_SNAPSHOTS_KEEP=10

# Resource guards (ADR-0004): `on` (default) lets setup FILL mcp.sessionIdleTtlMs (30 min idle eviction of
# per-session MCP runtimes) and agents.defaults.timeoutSeconds (4 h run cap) when they are unset. A value
# the operator already set is never overwritten, 0 included. `off` makes setup skip both keys; it does not
# revert a value already written (use `openclaw config unset` for that).
#OPENCLAW_RESOURCE_GUARDS=on

# Directory searched BEFORE the default PATH, if openclaw or kubectl live elsewhere.
OPENCLAW_EXTRA_PATH=

# Extra hook names `openclaw-verify.sh` must find registered in ~/.claude/settings.json,
# space separated (the kit's own are always checked when installed).
OPENCLAW_VERIFY_HOOKS=

# Optional verify checks. They are off because a generic host has no ingress, no OTLP
# receiver and no Flux; turn on only what this host really runs.
OPENCLAW_VERIFY_INGRESS=0
OPENCLAW_PUBLIC_URL=
OPENCLAW_VERIFY_OTLP=0
OPENCLAW_OTLP_ENDPOINT=
OPENCLAW_VERIFY_ALLOY_FILTER=0
OPENCLAW_VERIFY_FLUX=0
