# ~/.openclaw/kit-host.env — the host-specific values the OpenClaw host scripts read.
#
# `ai-resources setup` writes this file from the questions it asks. To do it by hand, copy this
# file to ~/.openclaw/kit-host.env and edit it. Secrets never belong here: use `openclaw configure`.
# It is sourced by bash and read by the team hook, so keep it to plain KEY=value lines.

# Telegram id of the operator, for failure notices. Empty: the scripts log and stay quiet.
OPENCLAW_OWNER_TELEGRAM_ID=

# Where the backup tiers (daily/weekly/monthly) are written. Stage on disk, never on /tmp.
OPENCLAW_BACKUP_DIR=/srv/openclaw-backups

# Workspaces (paths relative to $HOME, space separated) added to the backup on top of the
# ones read from openclaw.json.
OPENCLAW_BACKUP_EXTRA=

# How much the team hook narrates into Telegram: milestones | every-step. ABSENT MEANS OFF: the
# hook publishes nothing without this key, even in a session started by the gateway. Present only
# when the team narration hook is enabled; `openclaw-verify.sh` then expects the hook to be registered.
#OPENCLAW_NARRATION=milestones

# 1 when the gateway guard hook is enabled (verify then expects it to be registered).
#OPENCLAW_GUARD=1

# Written by `ai-resources openclaw bootstrap` when it installs openclaw (the kit installs the
# latest, not a pin). This file is then the only record of which version was running: back it up,
# and restore it before anything else on a rebuild. PREVIOUS is the one-command rollback target.
#OPENCLAW_INSTALLED_VERSION=
#OPENCLAW_PREVIOUS_VERSION=

# Directory searched BEFORE the default PATH, if openclaw or kubectl live elsewhere.
OPENCLAW_EXTRA_PATH=

# Extra hook names `openclaw-verify.sh` must find registered in ~/.claude/settings.json,
# space separated (the kit's own are always checked when installed).
OPENCLAW_VERIFY_HOOKS=

# Optional verify checks. They are off because a generic host has no ingress, no OTLP
# receiver and no Flux; turn on only what this host really runs.
OPENCLAW_VERIFY_INGRESS=0
OPENCLAW_PUBLIC_URL=
OPENCLAW_VERIFY_OTLP=0
OPENCLAW_OTLP_ENDPOINT=
OPENCLAW_VERIFY_ALLOY_FILTER=0
OPENCLAW_VERIFY_FLUX=0
