.claude/settings.local.json
scripts/__pycache__/
scripts/**/__pycache__/
**/__pycache__/
*.pyc

# eval runs write reports here
evals/results/
# Workflow artifacts (plans, handoffs, spike captures — may hold real user content)
.agent-output/
