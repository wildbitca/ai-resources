[Unit]
Description=OpenClaw gateway health check (confirmed memory pressure: a gated graceful restart, ADR-0004; otherwise it only notifies)
Documentation=file:///LIVE/bin/openclaw-health-restart.sh

[Service]
Type=oneshot
# Worst-case budget of one memory-triggered run (ADR-0004, "Time budget"), every phase bounded: script
# probes 360 s + restart attempts and backoffs 900 s + health poll 185 s + settle 180 s + bookkeeping
# probes 780 s + notices 180 s = 2585 s (43 min). A drained doctor (legacy health trigger) needs less.
# SIGKILL at this limit would skip the marker cleanup, so keep it above the sum.
TimeoutStartSec=50min
ExecStart=/LIVE/bin/openclaw-health-restart.sh
