{
  "patch": {
    "agents": {
      "defaults": {
        "heartbeat": {
          "every": "0m"
        }
      },
      "entries": {
        "app": {
          "model": {
            "primary": "anthropic/claude-sonnet-5"
          }
        },
        "infra": {
          "model": {
            "primary": "anthropic/claude-sonnet-5"
          }
        },
        "main": {
          "heartbeat": {
            "every": "2h"
          },
          "thinkingDefault": "high"
        }
      }
    },
    "channels": {
      "telegram": {
        "streaming": {
          "mode": "progress",
          "preview": {
            "toolProgress": true
          },
          "progress": {
            "commentary": true,
            "maxLines": 14,
            "toolProgress": true
          }
        }
      }
    },
    "gateway": {
      "allowRealIpFallback": true,
      "bind": "tailnet",
      "controlUi": {
        "allowedOrigins": [
          "https://old.example.org",
          "https://ai.example.org"
        ]
      },
      "publicOrigin": "https://ai.example.org",
      "trustedProxies": [
        "192.0.2.0/24",
        "10.9.0.0/24"
      ]
    },
    "logging": {
      "file": "/home/u/.openclaw/logs/gateway.log",
      "maxFileBytes": 33554432
    },
    "plugins": {
      "entries": {
        "device-pair": {
          "config": {
            "publicUrl": "https://ai.example.org"
          }
        }
      }
    },
    "tools": {
      "alsoAllow": [
        "group:web",
        "group:messaging"
      ],
      "profile": "coding"
    }
  },
  "replace_paths": [],
  "skipped": [
    "gateway.controlUi.github.token: GH_TOKEN is not available on this host (set it with `openclaw configure`)"
  ]
}
