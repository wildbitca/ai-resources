{
  "patch": {
    "agents": {
      "defaults": {
        "contextPruning": {
          "mode": "cache-ttl"
        },
        "heartbeat": {
          "every": "0m"
        },
        "models": {
          "anthropic/claude-opus-5-5": {
            "params": {
              "anthropicCompactThreshold": 150000,
              "anthropicServerCompaction": true
            }
          },
          "anthropic/claude-sonnet-5-5": {
            "params": {
              "anthropicCompactThreshold": 150000,
              "anthropicServerCompaction": true
            }
          }
        },
        "subagents": {
          "maxChildrenPerAgent": 3,
          "maxConcurrent": 3,
          "maxSpawnDepth": 2,
          "runTimeoutSeconds": 7200
        },
        "thinkingDefault": "low",
        "timeoutSeconds": 14400,
        "utilityModel": "anthropic/claude-haiku-5-5"
      },
      "entries": {
        "app": {
          "model": {
            "primary": "anthropic/claude-sonnet-5-5"
          }
        },
        "infra": {
          "model": {
            "primary": "anthropic/claude-sonnet-5-5"
          }
        },
        "main": {
          "heartbeat": {
            "every": "2h",
            "isolatedSession": true,
            "lightContext": true
          },
          "thinkingDefault": "medium"
        }
      }
    },
    "channels": {
      "telegram": {
        "streaming": {
          "mode": "progress",
          "preview": {
            "toolProgress": true
          },
          "progress": {
            "commentary": true,
            "maxLines": 14,
            "toolProgress": true
          }
        }
      }
    },
    "gateway": {
      "allowRealIpFallback": true,
      "bind": "tailnet",
      "controlUi": {
        "allowedOrigins": [
          "https://old.example.org",
          "https://ai.example.org"
        ]
      },
      "publicOrigin": "https://ai.example.org",
      "trustedProxies": [
        "192.0.2.0/24",
        "10.9.0.0/24"
      ]
    },
    "logging": {
      "file": "/home/u/.openclaw/logs/gateway.log",
      "maxFileBytes": 33554432
    },
    "mcp": {
      "sessionIdleTtlMs": 1800000
    },
    "plugins": {
      "entries": {
        "device-pair": {
          "config": {
            "publicUrl": "https://ai.example.org"
          }
        }
      }
    },
    "session": {
      "reset": {
        "idleMinutes": 120,
        "mode": "idle"
      },
      "resetByType": {
        "group": {
          "idleMinutes": 120,
          "mode": "idle"
        },
        "thread": {
          "idleMinutes": 120,
          "mode": "idle"
        }
      }
    },
    "tools": {
      "alsoAllow": [
        "group:web",
        "group:messaging"
      ],
      "profile": "coding"
    }
  },
  "replace_paths": [],
  "skipped": [
    "gateway.controlUi.github.token: GH_TOKEN is not available on this host (set it with `openclaw configure`)"
  ]
}
