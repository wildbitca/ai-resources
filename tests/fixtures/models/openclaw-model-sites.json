{
  "channels": {
    "telegram": {
      "allowFrom": [
        "1"
      ],
      "bindings": [
        {
          "topic": 1
        }
      ]
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "anthropic/claude-haiku-4-5",
        "fallbacks": [
          "anthropic/claude-sonnet-5",
          "anthropic/claude-opus-5"
        ]
      },
      "heartbeat": {
        "every": "0m",
        "model": "anthropic/claude-haiku-4-5"
      },
      "models": {
        "anthropic/claude-sonnet-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        },
        "anthropic/claude-haiku-4-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        },
        "anthropic/claude-opus-5": {
          "agentRuntime": {
            "id": "claude-cli"
          }
        }
      }
    },
    "entries": {
      "main": {
        "model": {
          "primary": "anthropic/claude-sonnet-5"
        },
        "heartbeat": {
          "every": "2h"
        }
      },
      "snoutzone": {
        "model": "anthropic/claude-sonnet-5"
      },
      "elinvo": {
        "model": {
          "primary": "anthropic/claude-sonnet-5",
          "fallbacks": [
            "anthropic/claude-haiku-4-5"
          ]
        }
      },
      "devops": {
        "model": "anthropic/claude-opus-5"
      },
      "claude": {
        "model": {
          "primary": "claude-kit/claude-sonnet-5"
        }
      },
      "ai": {
        "model": {
          "primary": "openai/gpt-5.6-sol"
        }
      },
      "security": {
        "model": {
          "primary": "anthropic/claude-opus-5"
        }
      }
    }
  }
}